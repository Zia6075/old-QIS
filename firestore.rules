rules_version = '2';

// ============================================
// Firestore rules — QIS HR & Visa System
// ============================================
// ⚠️ Yeh app Firestore use NAHI karti — poora data Realtime Database
//    (database.rules.json) mein hai.
// Is liye Firestore ko poori tarah BAND rakha gaya hai: koi bhi (signed-in bhi)
// yahan read/write nahi kar sakta. Is se aap ka quota bhi bachta hai aur
// koi chupke se data likh bhi nahi sakta.
//
// Agar kabhi Firestore use karna ho to neeche wala "ALLOW" block istemal karein.
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // SAB BAND (recommended — app Firestore use nahi karti)
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Agar kabhi Firestore chahiye ho to upar wala block hata kar yeh lagayein ──
    // match /{document=**} {
    //   allow read, write: if request.auth != null
    //     && request.auth.token.email != null
    //     && (request.auth.token.email.toLowerCase() == 'admin@qis.local'
    //      || request.auth.token.email.toLowerCase() == 'staff@qis.local'
    //      || request.auth.token.email.toLowerCase() == 'ishaq@gmail.com'
    //      || request.auth.token.email.toLowerCase() == 'queenschool@gmail.com');
    // }
  }
}
