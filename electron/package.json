{
  "name": "queen-international-school-hr",
  "version": "5.14.10",
  "description": "Queen International School - HR & Visa Management System",
  "main": "main.js",
  "author": "Queen International School",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "clean-installer": "node clean-installer.cjs",
    "build-win": "npm run clean-installer && electron-builder --win --x64",
    "build-installer": "npm run clean-installer && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.queenschool.hrsystem",
    "productName": "Queen International School HR System",
    "copyright": "Copyright © 2026 Queen International School",
    "directories": {
      "output": "installer"
    },
    "files": [
      "main.js",
      "updater.js",
      "server.js",
      "package.json",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "QIS_HR_System_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QIS HR System",
      "include": null,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1"
  }
}
